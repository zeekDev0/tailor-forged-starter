---
interface Props {
  businessName: string;
  subbrand: string;
}

const { businessName, subbrand } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="#home" aria-label={`${businessName} home`}>
    <span class="brand-mark">TF</span>
    <span>
      {businessName.toUpperCase()}
      <small>{subbrand.toUpperCase()}</small>
    </span>
  </a>

  <nav aria-label="Main navigation">
    <a href="#services">Services</a>
    <a href="#process">Our Process</a>
    <a class="nav-cta" href="#contact">Get a Quote</a>
  </nav>
</header>

<style>
  .site-header {
    min-height: 84px;
    padding: 18px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #e8e3db;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    line-height: 1.4;
    text-decoration: none;
    color: inherit;
  }

  .brand small {
    display: block;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 3px;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: #1e1e1c;
    color: #f8f7f4;
    font-size: 13px;
    letter-spacing: -1px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 13px;
  }

  nav a {
    color: #55514b;
    text-decoration: none;
  }

  nav .nav-cta {
    border: 1px solid #1e1e1c;
    padding: 10px 16px;
    color: #1e1e1c;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }
  }
</style>
