---
import { site } from "../config/site";
---

<p class="eyebrow">{site.hero.eyebrow}</p>
<h1>{site.hero.heading}</h1>
<p class="hero-copy">{site.hero.description}</p>
<a class="button" href="#contact">
  {site.hero.buttonText}
  <span aria-hidden="true">↗</span>
</a>
<p class="hero-note">{site.hero.note}</p>
<div class="hero-stamp" aria-hidden="true">
  {site.hero.stamp.map((line, index) =>
    index === 1 ? <strong>{line}</strong> : <span>{line}</span>
  )}
</div>

<style>
  .eyebrow {
    color: var(--color-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  h1 {
    max-width: 780px;
    margin: 22px 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1.06;
    letter-spacing: -2px;
  }

  .hero-copy {
    max-width: 520px;
    color: var(--color-secondary);
    font-size: 18px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    margin-top: 22px;
    padding: 15px 20px;
    background: var(--color-foreground);
    color: var(--color-inverse);
    font-size: 13px;
    font-weight: 700;
  }

  .button span {
    color: var(--color-accent-contrast);
  }

  .hero-note {
    color: var(--color-muted);
    font-size: 12px;
  }

  .hero-stamp {
    position: absolute;
    right: 9%;
    bottom: 70px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    padding: 24px;
    color: var(--color-accent);
    font-size: 10px;
    letter-spacing: 3px;
    transform: rotate(7deg);
  }

  .hero-stamp strong {
    color: var(--color-foreground);
    font-size: 29px;
    letter-spacing: 1px;
  }

  @media (max-width: 760px) {
    h1 {
      letter-spacing: -1.5px;
    }

    .hero-stamp {
      display: none;
    }
  }
</style>