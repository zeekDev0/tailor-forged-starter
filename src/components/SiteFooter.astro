---
import { site } from "../config/site";
---

<a class="brand footer-brand" href="#home" aria-label={`${site.businessName} home`}>
  <span class="brand-mark">{site.brandMark}</span>
  <span class="brand-text">
    <span class="brand-name">{site.businessName.toUpperCase()}</span>
    <small>{site.subbrand.toUpperCase()}</small>
  </span>
</a>

<p>{site.footer.tagline}</p>

<span class="copyright">
  © {new Date().getFullYear()}
  <span class="brand-name"> {site.businessName} {site.subbrand}</span>
</span>

<style>
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-foreground);
    text-decoration: none;
    flex-shrink: 0;
  }

  .footer-brand .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--color-foreground);
    color: var(--color-inverse);
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .footer-brand .brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1.1;
  }

  .footer-brand .brand-name {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    white-space: nowrap;
  }

  .footer-brand small {
    font-size: 9px;
    letter-spacing: 2.2px;
  }

  p {
    margin: 0;
  }

  .copyright {
    white-space: nowrap;
  }
</style>