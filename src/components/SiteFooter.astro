---
import { site } from "../pages/data/site";
---

<a class="brand footer-brand" href="#home" aria-label="Tailor Forged home">
  <span class="brand-mark">TF</span>
  <span class="brand-text">
    <span class="brand-name">{site.businessName.toUpperCase()}</span>
    <small>{site.subbrand.toUpperCase()}</small>
  </span>
</a>

<p>Thoughtful digital work for businesses ready to grow.</p>

<span class="copyright">
  © {new Date().getFullYear()}
  <span class="brand-name"> {site.businessName} {site.subbrand}</span>
</span>

<style>
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 7%;
    border-top: 1px solid #e8e3db;
    font-size: 11px;
    color: #625d56;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #1e1e1c;
    text-decoration: none;
    flex-shrink: 0;
  }

  .footer-brand .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: #1e1e1c;
    color: #f8f7f4;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .footer-brand .brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1.1;
  }

  .footer-brand .brand-name {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    white-space: nowrap;
  }

  .footer-brand small {
    font-size: 9px;
    letter-spacing: 2.2px;
  }

  footer p {
    margin: 0;
  }

  footer .copyright {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
