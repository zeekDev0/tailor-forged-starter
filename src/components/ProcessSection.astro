---
import { site } from "../pages/data/site";
---

<div class="section-heading">
  <p class="eyebrow">HOW WE WORK</p>
  <h2>Simple by design.</h2>
  <p>A clear process from the first conversation to ongoing support.</p>
</div>
<div class="process-grid">
  {
    site.process.map((step) => (
      <article class="process-card">
        <span>{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </article>
    ))
  }
</div>

<style>
  .process-section {
    padding: 85px 8%;
  }
  .process-section .eyebrow {
    color: #8b6a48;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  },

  .process-card p {
    color: #625d56;
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .process-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .process-card > span {
    color: #8b6a48;
    font-size: 12px;
    font-weight: 800;
  }
  .process-card h3 {
    margin-bottom: 8px;
    font-size: 20px;
  }
  .process-card p {
    font-size: 14px;
  }
  .process-section {
    background: #e8e3db;
  }
  .process-card {
    padding: 12px 0;
  }
  .process-section {
    padding: 60px 7%;
  }
    .process-grid {
    grid-template-columns: 1fr;
  }

</style>
