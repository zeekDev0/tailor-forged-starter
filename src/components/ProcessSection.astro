---
import { site } from "../config/site";
---

<div class="section-heading">
  <p class="eyebrow">{site.processSection.eyebrow}</p>
  <h2>{site.processSection.heading}</h2>
  <p>{site.processSection.description}</p>
</div>

<div class="process-grid">
  {
    site.process.map((step) => (
      <article class="process-card">
        <span>{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </article>
    ))
  }
</div>

<style>
  .section-heading {
    max-width: 650px;
    margin-bottom: 36px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  h2 {
    margin: 12px 0;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.15;
    letter-spacing: -1.5px;
  }

  .section-heading > p:last-child,
  .process-card p {
    color: var(--color-muted);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .process-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
    padding: 12px 0;
  }

  .process-card > span {
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 800;
  }

  .process-card h3 {
    margin-bottom: 8px;
    font-size: 20px;
  }

  .process-card p {
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>