---
import { profiles, type ProfileSlug } from "../config/profiles";

export function getStaticPaths() {
  return Object.entries(profiles).map(([profile, site]) => ({
    params: { profile },
    props: { site },
  }));
}

type Props = {
  site: (typeof profiles)[ProfileSlug];
};

const { site } = Astro.props as Props;
const themeStyles = Object.entries(site.colors)
  .map(([name, value]) => `--color-${name.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}: ${value}`)
  .join("; ");
const contactSubject = encodeURIComponent(`Website inquiry for ${site.businessName}`);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.seo.description} />
    <meta name="theme-color" content={site.colors.background} />
    <meta property="og:title" content={site.seo.title} />
    <meta property="og:description" content={site.seo.description} />
    <title>{site.seo.title}</title>
  </head>
  <body style={themeStyles}>
    <header class="site-header">
      <a class="brand" href="#home" aria-label={`${site.businessName} home`}>
        <span class="brand-mark">{site.brandMark}</span>
        <span class="brand-copy">{site.businessName}<small>{site.subbrand}</small></span>
      </a>
      <nav aria-label="Main navigation">
        {site.navigation.map((item) => (
          <a class:list={["nav-link", { "nav-cta": "emphasis" in item && item.emphasis }]} href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-content">
          <p class="eyebrow">{site.hero.eyebrow}</p>
          <h1>{site.hero.heading}</h1>
          <p class="hero-copy">{site.hero.description}</p>
          <a class="button" href="#contact">{site.hero.buttonText}<span aria-hidden="true">↗</span></a>
          <p class="hero-note">{site.hero.note}</p>
        </div>
        <div class="hero-stamp" aria-hidden="true">
          {site.hero.stamp.map((line, index) => index === 1 ? <strong>{line}</strong> : <span>{line}</span>)}
        </div>
      </section>

      <section class="section about-section" id="about">
        <div class="section-heading">
          <p class="eyebrow">{site.about.eyebrow}</p>
          <h2>{site.about.heading}</h2>
          <p>{site.about.description}</p>
        </div>
      </section>

      <section class="section" id="services">
        <div class="section-heading">
          <p class="eyebrow">{site.servicesSection.eyebrow}</p>
          <h2>{site.servicesSection.heading}</h2>
          <p>{site.servicesSection.description}</p>
        </div>
        <div class="service-grid">
          {site.services.map((service) => (
            <article class="service-card">
              <span class="card-number">{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a href="#contact">{site.servicesSection.cardLinkText} ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section process-section" id="process">
        <div class="section-heading">
          <p class="eyebrow">{site.processSection.eyebrow}</p>
          <h2>{site.processSection.heading}</h2>
          <p>{site.processSection.description}</p>
        </div>
        <div class="process-grid">
          {site.process.map((step) => (
            <article class="process-card">
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section showcase-section" id="showcase">
        <div class="section-heading">
          <p class="eyebrow">{site.showcase.eyebrow}</p>
          <h2>{site.showcase.heading}</h2>
          <p>{site.showcase.description}</p>
        </div>
        <div class="showcase-grid">
          {site.showcase.items.map((item, index) => (
            <article class:list={["showcase-card", { "showcase-featured": index === 0 }]}>
              <span class="showcase-index">{String(index + 1).padStart(2, "0")}</span>
              <p class="showcase-label">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a href="#contact">Learn more ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="contact-section" id="contact">
        <div>
          <p class="eyebrow">{site.contact.eyebrow}</p>
          <h2>{site.contact.heading}</h2>
          <p>{site.contact.description}</p>
        </div>
        <a class="button button-light" href={`mailto:${site.email}?subject=${contactSubject}`}>{site.contact.buttonText}<span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand footer-brand" href="#home">
        <span class="brand-mark">{site.brandMark}</span>
        <span class="brand-copy">{site.businessName}<small>{site.subbrand}</small></span>
      </a>
      <p>{site.footer.tagline}</p>
      <span>© {new Date().getFullYear()} {site.businessName}</span>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }
  :global(a) { color: inherit; text-decoration: none; }
  .site-header {
    min-height: 84px; padding: 18px 7%; display: flex; align-items: center;
    justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--color-neutral);
  }
  .brand { display: flex; align-items: center; gap: 12px; min-width: 0; font-size: 12px; font-weight: 800; letter-spacing: 1.2px; line-height: 1.4; }
  .brand-mark { display: grid; place-items: center; width: 42px; height: 42px; flex-shrink: 0; background: var(--color-foreground); color: var(--color-inverse); font-size: 13px; letter-spacing: -1px; }
  .brand-copy { display: block; overflow-wrap: anywhere; }
  .brand-copy small { display: block; margin-top: 3px; font-size: 9px; font-weight: 500; letter-spacing: 2px; }
  nav { display: flex; align-items: center; justify-content: flex-end; gap: 22px; font-size: 12px; }
  .nav-link { color: var(--color-secondary); }
  .nav-cta { padding: 10px 14px; border: 1px solid var(--color-foreground); color: var(--color-foreground); }
  .hero { position: relative; display: flex; align-items: center; min-height: 490px; padding: 76px 8%; overflow: hidden; }
  .hero-content { position: relative; z-index: 1; max-width: 800px; }
  .eyebrow { color: var(--color-accent); font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }
  h1 { max-width: 780px; margin: 20px 0; font-size: clamp(42px, 6vw, 74px); line-height: 1.04; letter-spacing: -2px; }
  .hero-copy { max-width: 570px; color: var(--color-secondary); font-size: 18px; }
  .button { display: inline-flex; align-items: center; gap: 18px; margin-top: 20px; padding: 14px 18px; background: var(--color-foreground); color: var(--color-inverse); font-size: 13px; font-weight: 700; }
  .button span { color: var(--color-accent-contrast); }
  .hero-note { max-width: 600px; color: var(--color-muted); font-size: 11px; }
  .hero-stamp { position: absolute; right: 9%; bottom: 70px; display: flex; flex-direction: column; padding: 22px; border: 1px solid var(--color-border); color: var(--color-accent); font-size: 10px; letter-spacing: 3px; transform: rotate(6deg); }
  .hero-stamp strong { color: var(--color-foreground); font-size: 28px; letter-spacing: 1px; }
  .section { padding: 64px 8%; }
  .about-section { border-top: 1px solid var(--color-neutral); }
  .section-heading { max-width: 720px; margin-bottom: 34px; }
  h2 { margin: 10px 0 14px; font-size: clamp(30px, 4vw, 46px); line-height: 1.12; letter-spacing: -1.3px; }
  .section-heading > p:last-child, .service-card p, .process-card p, .showcase-card > p:not(.showcase-label) { color: var(--color-muted); }
  .service-grid, .showcase-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .service-card, .showcase-card { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; padding: 24px; border: 1px solid var(--color-neutral); background: var(--color-card); }
  .service-card { min-height: 230px; }
  .card-number, .process-card > span, .showcase-index { color: var(--color-accent); font-size: 12px; font-weight: 800; }
  h3 { margin: 10px 0 6px; font-size: 20px; line-height: 1.25; }
  .service-card p, .process-card p, .showcase-card > p { font-size: 14px; }
  .service-card a, .showcase-card a { margin-top: auto; padding-top: 18px; font-size: 12px; font-weight: 700; }
  .process-section { background: var(--color-neutral); }
  .process-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .process-card { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .showcase-card { min-height: 250px; }
  .showcase-featured { border-top: 3px solid var(--color-accent); }
  .showcase-label { margin: 14px 0 0; color: var(--color-accent); font-size: 10px !important; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; }
  .contact-section { display: flex; align-items: center; justify-content: space-between; gap: 36px; padding: 58px 8%; background: var(--color-foreground); color: var(--color-inverse); }
  .contact-section > div { max-width: 680px; }
  .contact-section .eyebrow { color: var(--color-accent-contrast); }
  .contact-section p:last-child { color: var(--color-neutral); }
  .button-light { flex-shrink: 0; background: var(--color-inverse); color: var(--color-inverse-foreground); }
  .button-light span { color: var(--color-accent); }
  .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 28px 8%; border-top: 1px solid var(--color-neutral); color: var(--color-muted); font-size: 11px; }
  .footer-brand { color: var(--color-foreground); flex-shrink: 0; }
  .site-footer > p { margin: 0; }
  @media (min-width: 1100px) { .hero { min-height: 540px; padding-right: 10%; padding-left: 10%; } }
  @media (max-width: 850px) {
    .site-header { align-items: flex-start; flex-direction: column; }
    nav { width: 100%; justify-content: flex-start; flex-wrap: wrap; gap: 12px 18px; }
    .hero-stamp { right: 6%; bottom: 35px; opacity: .65; }
    .service-grid, .showcase-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer { align-items: flex-start; flex-direction: column; gap: 14px; }
  }
  @media (max-width: 560px) {
    .hero { min-height: 430px; padding: 56px 7%; }
    h1 { font-size: clamp(38px, 11vw, 54px); letter-spacing: -1.4px; }
    .hero-copy { font-size: 16px; }
    .hero-stamp { display: none; }
    .section { padding: 48px 7%; }
    .service-grid, .showcase-grid, .process-grid { grid-template-columns: 1fr; }
    .service-card, .showcase-card { min-height: 0; }
    .contact-section { align-items: flex-start; flex-direction: column; padding: 48px 7%; }
    .nav-cta { padding: 8px 10px; }
  }
</style>
