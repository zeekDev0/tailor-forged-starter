---
import { site } from "../config/site";
import SiteHeader from "../components/SiteHeader.astro";
import HeroSection from "../components/HeroSection.astro";
import ServiceSection from "../components/ServiceSection.astro";
import ProcessSection from "../components/ProcessSection.astro";
import ContactSection from "../components/ContactSection.astro";
import SiteFooter from "../components/SiteFooter.astro";

const themeStyles = Object.entries(site.colors)
  .map(([name, value]) => `--color-${name.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}: ${value}`)
  .join("; ");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.seo.description} />
    <meta name="theme-color" content={site.colors.background} />
    <title>{site.seo.title}</title>
  </head>
  <body style={themeStyles}>
    <SiteHeader />

    <main>
      <section class="hero" id="home">
        <HeroSection />
      </section>

      <section class="section" id="services">
        <ServiceSection />
      </section>

      <section class="process-section" id="process">
        <ProcessSection />
      </section>

      <section class="contact-section" id="contact">
        <ContactSection />
      </section>
    </main>

    <footer class="site-footer">
      <SiteFooter />
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(.hero) {
    position: relative;
    min-height: 480px;
    padding: 75px 7%;
    overflow: hidden;
  }

  :global(.section),
  :global(.process-section) {
    padding: 60px 7%;
  }

  :global(.process-section) {
    background: var(--color-neutral);
  }

  :global(.contact-section) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 55px 7%;
    background: var(--color-foreground);
    color: var(--color-inverse);
  }

  :global(.contact-section > div) {
    max-width: 650px;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 7%;
    border-top: 1px solid var(--color-neutral);
    font-size: 11px;
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    :global(.hero) {
      min-height: 540px;
      padding: 100px 10%;
    }

    :global(.section),
    :global(.process-section) {
      padding: 85px 8%;
    }

    :global(.contact-section) {
      padding: 75px 8%;
    }
  }

  @media (max-width: 760px) {
    :global(.contact-section) {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }
  }
</style>