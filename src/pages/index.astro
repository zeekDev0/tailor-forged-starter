---
import { site } from "./data/site";
import SiteHeader from "../components/SiteHeader.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.seo.description} />
    <meta name="theme-color" content={site.colors.background} />
    <title>{site.seo.title}</title>
  </head>
  <body>
    <SiteHeader businessName={site.businessName} subbrand={site.subbrand} />

    <main>
      <section class="hero" id="home">
        <p class="eyebrow">{site.hero.eyebrow}</p>
        <h1>{site.hero.heading}</h1>
        <p class="hero-copy">{site.hero.description}</p>
        <a class="button" href="#contact">
          {site.hero.buttonText}
          <span>↗</span>
        </a>
        <p class="hero-note">{site.hero.note}</p>
        <div class="hero-stamp" aria-hidden="true">
          <span>BUILT</span>
          <strong>FOR</strong>
          <span>GROWTH.</span>
        </div>
      </section>

      <section class="section" id="services">
        <div class="section-heading">
          <p class="eyebrow">WHAT WE DO</p>
          <h2>A stronger digital foundation.</h2>
          <p>Practical digital services built around your business.</p>
        </div>
        <div class="service-grid">
          {
            site.services.map((service) => (
              <article class="service-card">
                <span class="card-number">{service.number}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <a href="#contact" aria-label={`Ask about ${service.title}`}>
                  Discuss your project ↗
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="process-section" id="process">
        <div class="section-heading">
          <p class="eyebrow">HOW WE WORK</p>
          <h2>Simple by design.</h2>
          <p>A clear process from the first conversation to ongoing support.</p>
        </div>
        <div class="process-grid">
          {
            site.process.map((step) => (
              <article class="process-card">
                <span>{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="contact-section" id="contact">
        <div>
          <p class="eyebrow">{site.contact.eyebrow}</p>
          <h2>{site.contact.heading}</h2>
          <p>
            {site.contact.description}
          </p>
        </div>
        <a class="button button-light" href={site.email}>
          {site.contact.buttonText}
          <span>↗</span>
        </a>
      </section>
    </main>

    <footer>
      <a
        class="brand footer-brand"
        href="#home"
        aria-label="Tailor Forged home"
      >
        <span class="brand-mark">TF</span>
        <span class="brand-text">
          <span class="brand-name">{site.businessName.toUpperCase()}</span>
          <small>{site.subbrand.toUpperCase()}</small>
        </span>
      </a>

      <p>Thoughtful digital work for businesses ready to grow.</p>

      <span class="copyright">
        © {new Date().getFullYear()}
        <span class="brand-name"> {site.businessName} {site.subbrand}</span>
        
      </span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #f8f7f4;
    color: #1e1e1c;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 115px 10% 105px;
    min-height: 540px;
  }
  .eyebrow {
    color: #8b6a48;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  }
  h1 {
    max-width: 780px;
    margin: 22px 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1.06;
    letter-spacing: -3px;
  }
  .hero-copy {
    max-width: 520px;
    color: #55514b;
    font-size: 18px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    margin-top: 22px;
    padding: 15px 20px;
    background: #1e1e1c;
    color: white;
    font-size: 13px;
    font-weight: 700;
  }
  .button span {
    color: #c5a17b;
  }
  .hero-note {
    color: #777168;
    font-size: 12px;
  }
  .hero-stamp {
    position: absolute;
    right: 9%;
    bottom: 95px;
    display: flex;
    flex-direction: column;
    border: 1px solid #d8cfc2;
    padding: 24px;
    color: #8b6a48;
    font-size: 10px;
    letter-spacing: 3px;
    transform: rotate(7deg);
  }
  .hero-stamp strong {
    color: #1e1e1c;
    font-size: 29px;
    letter-spacing: 1px;
  }
  .section,
  .process-section {
    padding: 85px 8%;
  }
  .section-heading {
    max-width: 650px;
    margin-bottom: 36px;
  }
  h2 {
    margin: 12px 0;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.15;
    letter-spacing: -1.5px;
  }
  .section-heading > p:last-child,
  .service-card p,
  .process-card p {
    color: #625d56;
  }
  .service-grid,
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .service-card {
    min-height: 230px;
    padding: 25px;
    border: 1px solid #e1dbd2;
    background: #fffefa;
  }
  .card-number,
  .process-card > span {
    color: #8b6a48;
    font-size: 12px;
    font-weight: 800;
  }
  .service-card h3,
  .process-card h3 {
    margin-bottom: 8px;
    font-size: 20px;
  }
  .service-card p,
  .process-card p {
    font-size: 14px;
  }
  .service-card a {
    display: inline-block;
    margin-top: 12px;
    font-size: 12px;
    font-weight: 700;
  }
  .process-section {
    background: #e8e3db;
  }
  .process-card {
    padding: 12px 0;
  }
  .contact-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 75px 8%;
    background: #1e1e1c;
    color: #f8f7f4;
  }
  .contact-section > div {
    max-width: 650px;
  }
  .contact-section .eyebrow {
    color: #c5a17b;
  }
  .contact-section p:last-child {
    color: #c5c0b8;
  }
  .button-light {
    flex-shrink: 0;
    background: #f8f7f4;
    color: #1e1e1c;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 7%;
    border-top: 1px solid #e8e3db;
    font-size: 11px;
    color: #625d56;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #1e1e1c;
    text-decoration: none;
    flex-shrink: 0;
  }

  .footer-brand .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: #1e1e1c;
    color: #f8f7f4;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .footer-brand .brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1.1;
  }

  .footer-brand .brand-name {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    white-space: nowrap;
  }

  .footer-brand small {
    font-size: 9px;
    letter-spacing: 2.2px;
  }

  footer p {
    margin: 0;
  }

  footer .copyright {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }
  }
  nav {
    width: 100%;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .hero {
    padding: 75px 7%;
  }
  h1 {
    letter-spacing: -1.8px;
  }
  .hero-stamp {
    display: none;
  }
  .section,
  .process-section {
    padding: 60px 7%;
  }
  .service-grid,
  .process-grid {
    grid-template-columns: 1fr;
  }
  .contact-section {
    align-items: flex-start;
    flex-direction: column;
    padding: 55px 7%;
  }
</style>
