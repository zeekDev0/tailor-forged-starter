---
import { site } from "./data/site";
import SiteHeader from "../components/SiteHeader.astro";
import HeroSection from "../components/HeroSection.astro";
import ServiceSection from "../components/ServiceSection.astro";
import ProcessSection from "../components/ProcessSection.astro";
import ContactSection from "../components/ContactSection.astro";
import SiteFooter from "../components/SiteFooter.astro";

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.seo.description} />
    <meta name="theme-color" content={site.colors.background} />
    <title>{site.seo.title}</title>
  </head>
  <body>
    <SiteHeader businessName={site.businessName} subbrand={site.subbrand} />

    <main>
      <section class="hero" id="home">
        <HeroSection />
      </section>

      <section class="section" id="services">
       <ServiceSection services={site.services} />
      </section>

      <section class="process-section" id="process">
       <ProcessSection process={site.process} />
      </section>

      <section class="contact-section" id="contact">
        <ContactSection />
      </section>
    </main>

    <footer>
      <SiteFooter businessName={site.businessName} subbrand={site.subbrand} />
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #f8f7f4;
    color: #1e1e1c;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  
  .contact-section {
  
    background: #1e1e1c;
    color: #f8f7f4;
  }
  
  
  
 

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 7%;
    border-top: 1px solid #e8e3db;
    font-size: 11px;
    color: #625d56;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #1e1e1c;
    text-decoration: none;
    flex-shrink: 0;
  }

  .footer-brand .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: #1e1e1c;
    color: #f8f7f4;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .footer-brand .brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1.1;
  }

  .footer-brand .brand-name {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    white-space: nowrap;
  }

  .footer-brand small {
    font-size: 9px;
    letter-spacing: 2.2px;
  }

  footer p {
    margin: 0;
  }

  footer .copyright {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }
  }
  nav {
    width: 100%;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .hero {
    padding: 75px 7%;
  }
  h1 {
    letter-spacing: -1.8px;
  }
  .hero-stamp {
    display: none;
  }
  .section,
  .process-section {
    padding: 60px 7%;
  }
  .service-grid,
  .process-grid {
    grid-template-columns: 1fr;
  }
  .contact-section {
    align-items: flex-start;
    flex-direction: column;
    padding: 55px 7%;
  }
</style>
